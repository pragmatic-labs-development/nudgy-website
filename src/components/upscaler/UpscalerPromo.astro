---
---

<section class="promo-section">
  <div class="promo-card">
    <div class="promo-content">
      <span class="eyebrow">From the makers of this tool</span>
      <h3 class="promo-title">Capture better screenshots with Nudgy</h3>
      <p class="promo-text">
        Annotate screenshots, paste them into AI, and ship faster. Free Mac app, no account required.
      </p>
      <a href="/" class="promo-cta">
        Learn more
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .promo-section {
    padding: 2rem 1.5rem 3rem;
  }

  .promo-card {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    position: relative;
    overflow: hidden;
  }

  .promo-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.4;
  }

  .promo-content {
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .promo-title {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .promo-text {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 440px;
    margin: 0 auto 1.25rem;
  }

  .promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.2s, color 0.2s;
  }

  .promo-cta:hover {
    color: var(--accent-hover);
    gap: 0.55rem;
  }

  .promo-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
