---
const useCases = [
  { name: 'Slack Threads', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>` },
  { name: 'Long PRDs', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>` },
  { name: 'Contracts', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>` },
  { name: 'Error Logs', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>` },
  { name: 'Full Webpages', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>` },
  { name: 'DocuSign', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>` },
  { name: 'Code Files', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>` },
  { name: 'Email Threads', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>` },
  { name: 'GitHub Issues', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>` },
  { name: 'Spreadsheets', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>` },
];
---

<section class="scrolling-capture">
  <div class="container">
    <div class="content fade-target">
      <p class="eyebrow">Scrolling capture</p>
      <h2>Grab the whole page.<br class="br-desktop" /> macOS can't do this.</h2>
      <p class="body">Built-in screenshots give you fullscreen or a selected area. Nudgy captures beyond the viewport — entire threads, long documents, full pages — then drop it into AI for a summary instead of reading every page.</p>
    </div>

    <div class="cases fade-target" style="--delay: 120ms">
      <span class="cases-label">Scroll-capture into AI</span>
      <div class="case-grid">
        {useCases.map((item) => (
          <div class="case-card">
            <div class="case-icon" set:html={item.icon} />
            <span class="case-name">{item.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.style.getPropertyValue('--delay') || '0ms';
          setTimeout(() => el.classList.add('is-visible'), parseInt(delay));
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.2 }
  );
  document.querySelectorAll('.scrolling-capture .fade-target').forEach(el => observer.observe(el));
</script>

<style>
  .scrolling-capture {
    padding: 5rem 1.5rem 5.5rem;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .content {
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .br-desktop { display: inline; }

  .body {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 540px;
    margin: 0 auto;
  }

  /* ── Case chips ── */
  .cases-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 1rem;
  }

  .case-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .case-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 0.2s, background 0.2s;
  }

  .case-card:hover {
    border-color: rgba(255, 107, 43, 0.25);
    background: var(--surface-hover);
  }

  .case-icon {
    color: var(--accent);
    display: flex;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .case-card:hover .case-icon {
    opacity: 1;
  }

  .case-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  /* ── Scroll reveal ── */
  .fade-target {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .fade-target.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .br-desktop { display: none; }

    .scrolling-capture {
      padding: 4rem 1.25rem;
    }
  }
</style>
