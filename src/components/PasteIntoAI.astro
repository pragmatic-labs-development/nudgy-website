---
const tools = [
  { name: 'Claude', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>` },
  { name: 'ChatGPT', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>` },
  { name: 'Cursor', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>` },
  { name: 'Gemini', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>` },
  { name: 'Claude Code', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>` },
  { name: 'Windsurf', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7A7.1 7.1 0 0 0 6.3 6.3L3 3"/><path d="M21 12A9 9 0 0 0 3.1 8.7"/><path d="M3 21l2.3-2.3A7.1 7.1 0 0 0 17.7 17.7"/><path d="M21 12a9 9 0 0 1-17.9 3.3"/></svg>` },
];
---

<section class="paste-ai">
  <div class="container">
    <div class="content fade-target">
      <p class="eyebrow">AI-ready screenshots</p>
      <h2>Capture it. Mark it up.<br class="br-desktop" /> Drop it into your AI.</h2>
      <p class="body">Every major AI tool reads images natively. Nudgy lets you drag or paste an annotated screenshot straight into your conversation. Your AI sees exactly what you see — no describing, no guessing.</p>
    </div>

    <div class="tools fade-target" style="--delay: 120ms">
      <span class="tools-label">Paste into</span>
      <div class="tool-grid">
        {tools.map((tool) => (
          <div class="tool-card">
            <div class="tool-icon" set:html={tool.icon} />
            <span class="tool-name">{tool.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.style.getPropertyValue('--delay') || '0ms';
          setTimeout(() => el.classList.add('is-visible'), parseInt(delay));
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.2 }
  );
  document.querySelectorAll('.paste-ai .fade-target').forEach(el => observer.observe(el));
</script>

<style>
  .paste-ai {
    padding: 5rem 1.5rem 5.5rem;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .content {
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .br-desktop { display: inline; }

  .body {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 540px;
    margin: 0 auto;
  }

  /* ── Tool grid ── */
  .tools-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 1rem;
  }

  .tool-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .tool-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 0.2s, background 0.2s;
  }

  .tool-card:hover {
    border-color: rgba(255, 107, 43, 0.25);
    background: var(--surface-hover);
  }

  .tool-icon {
    color: var(--accent);
    display: flex;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .tool-card:hover .tool-icon {
    opacity: 1;
  }

  .tool-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  /* ── Scroll reveal ── */
  .fade-target {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .fade-target.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .br-desktop { display: none; }

    .paste-ai {
      padding: 4rem 1.25rem;
    }
  }
</style>
