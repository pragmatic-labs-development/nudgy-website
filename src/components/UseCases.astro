---
const audiences = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Vibe Coders',
    description: 'Give Claude, ChatGPT, or Cursor a screenshot instead of a paragraph. Capture UI states, annotate what needs changing, and help AI see what you mean.',
    mini: 'Stop describing pixels. Point at them.',
    tag: 'Most popular',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`,
    title: 'Product Managers',
    description: 'Grab screenshots from Slack, apps, or customer reports and mark them up for tickets, slide decks, and quick team alignment.',
    mini: 'Turn visual feedback into clearer next steps.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
    title: 'Designers',
    description: 'Call out spacing, hierarchy, alignment, copy, and visual polish without writing a design-review novel.',
    mini: 'Precise feedback, less back-and-forth.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    title: 'Developers & Engineers',
    description: 'Show bugs, broken states, layout issues, and implementation details with one clear marked-up screenshot.',
    mini: 'Make the issue obvious.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Support & Success',
    description: 'Turn customer screenshots into clear internal context so product and engineering can understand the issue faster.',
    mini: 'Customer context, cleaned up visually.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>`,
    title: 'Sales Engineers',
    description: 'Capture product moments, demo issues, integration questions, and customer feedback without slowing down the conversation.',
    mini: 'Fast visuals for technical conversations.',
  },
];
---

<section class="who-section" id="use-cases">
  <div class="container">
    <div class="section-header fade-target">
      <p class="eyebrow">Who it's for</p>
      <h2>Built for the messy middle<br class="br-desktop" /> of tech work.</h2>
      <p class="subtext">Nudgy is for the people who spend their day turning screenshots into decisions, fixes, feedback, and faster AI prompts.</p>
    </div>

    <div class="grid">
      {audiences.map((a, i) => (
        <div class={`card fade-target ${a.tag ? 'card--featured' : ''}`} style={`--delay: ${i * 80}ms`}>
          {a.tag && <span class="card-tag">{a.tag}</span>}
          <div class="icon-wrap">
            <div class="icon" set:html={a.icon} />
          </div>
          <h3>{a.title}</h3>
          <p class="card-desc">{a.description}</p>
          <p class="card-mini">{a.mini}</p>
        </div>
      ))}
    </div>

    <p class="closing fade-target" style="--delay: 560ms">When words are too slow, Nudgy helps the screenshot do the talking.</p>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.style.getPropertyValue('--delay') || '0ms';
          setTimeout(() => el.classList.add('is-visible'), parseInt(delay));
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('#use-cases .fade-target').forEach(el => observer.observe(el));
</script>

<style>
  .who-section {
    padding: 6rem 1.5rem 7rem;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin-bottom: 0.85rem;
    color: var(--text);
  }

  .br-desktop { display: inline; }

  .subtext {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  /* ── Card ── */
  .card {
    position: relative;
    background: var(--surface);
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: background 0.25s;
  }

  .card:hover {
    background: var(--surface-hover);
  }

  .card--featured {
    background: linear-gradient(160deg, rgba(255, 107, 43, 0.04) 0%, var(--surface) 100%);
  }

  .card--featured:hover {
    background: linear-gradient(160deg, rgba(255, 107, 43, 0.07) 0%, var(--surface-hover) 100%);
  }

  .card-tag {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(255, 107, 43, 0.1);
    border: 1px solid rgba(255, 107, 43, 0.22);
    padding: 0.18rem 0.55rem;
    border-radius: 9999px;
  }

  /* ── Icon ── */
  .icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(255, 107, 43, 0.07);
    border: 1px solid rgba(255, 107, 43, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: background 0.25s, border-color 0.25s;
  }

  .card:hover .icon-wrap {
    background: rgba(255, 107, 43, 0.12);
    border-color: rgba(255, 107, 43, 0.28);
  }

  .icon {
    color: var(--accent);
    display: flex;
    transition: filter 0.25s;
  }

  .card:hover .icon {
    filter: drop-shadow(0 0 5px rgba(255, 107, 43, 0.5));
  }

  /* ── Typography ── */
  .card h3 {
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--text);
    letter-spacing: -0.015em;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.65;
    flex-grow: 1;
  }

  .card-mini {
    font-size: 0.78rem;
    font-style: italic;
    color: var(--accent);
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 107, 43, 0.1);
    line-height: 1.5;
    letter-spacing: -0.01em;
    opacity: 0.85;
    transition: opacity 0.25s;
  }

  .card:hover .card-mini {
    opacity: 1;
  }

  /* ── Closing ── */
  .closing {
    text-align: center;
    margin-top: 2.5rem;
    font-size: 0.88rem;
    color: var(--muted);
    font-style: italic;
    letter-spacing: -0.01em;
  }

  /* ── Scroll reveal ── */
  .fade-target {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .fade-target.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .who-section {
      padding: 4rem 1.25rem 5rem;
    }

    .br-desktop { display: none; }
  }

  @media (min-width: 641px) and (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .br-desktop { display: none; }
  }
</style>
