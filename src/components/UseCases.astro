---
const useCases = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Vibe Coding',
    description: 'Capture your UI, annotate the problem, paste it into Claude or Cursor. AI sees exactly what you see. No more describing pixel positions in text.',
    tag: 'Most popular',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
    title: 'Bug Reporting',
    description: 'Circle the broken element, arrow to the wrong color, write "should be 16px." Drop it into a GitHub issue or Linear ticket. Context in seconds.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
    title: 'Design Feedback',
    description: 'Mark up mockups and live UI. Show your team or your AI exactly what needs to move, change, or get removed. Visual feedback beats written feedback.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: 'AI Prompting',
    description: 'Visual context makes AI responses dramatically better. Annotated screenshots remove ambiguity from prompts. Claude, ChatGPT, and Cursor all read images natively.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>`,
    title: 'Team Collaboration',
    description: 'Drop annotated screenshots into Slack, Linear, or GitHub. Everyone immediately sees the issue. No meetings to explain what\'s broken.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    title: 'Documentation',
    description: 'Annotate UI states, error screens, and app flows for docs or onboarding. Faster than writing step-by-step instructions from scratch.',
  },
];
---

<section class="use-cases" id="use-cases">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Who it's for</p>
      <h2>Built for builders who move fast.</h2>
      <p class="subtext">Whether you're vibe coding solo or shipping with a team, Nudgy fits the way you already work.</p>
    </div>

    <div class="grid">
      {useCases.map((uc) => (
        <div class={`card ${uc.tag ? 'card--featured' : ''}`}>
          {uc.tag && <span class="card-tag">{uc.tag}</span>}
          <div class="card-icon" set:html={uc.icon} />
          <h3>{uc.title}</h3>
          <p>{uc.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .use-cases {
    padding: 5rem 1.5rem 6rem;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.12;
    margin-bottom: 0.85rem;
    color: var(--text);
  }

  .subtext {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 2rem 1.5rem;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .card:hover {
    background: var(--surface-hover);
    border-color: rgba(255, 107, 43, 0.12);
    transform: translateY(-2px);
  }

  .card--featured {
    border-color: rgba(255, 107, 43, 0.18);
    background: linear-gradient(160deg, rgba(255, 107, 43, 0.04) 0%, var(--surface) 100%);
  }

  .card--featured:hover {
    border-color: rgba(255, 107, 43, 0.3);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(255, 107, 43, 0.1);
    border: 1px solid rgba(255, 107, 43, 0.22);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .card-icon {
    color: var(--accent);
    display: flex;
    margin-bottom: 1.25rem;
  }

  .card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .card p {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
