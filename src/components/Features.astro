---
const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>`,
    title: 'Capture Anything',
    description: 'Grab a region, window, or full screen without breaking your flow. One global shortcut from anywhere on your Mac.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`,
    title: 'Annotate Fast',
    description: 'Use arrows, shapes, blur, highlights, and notes to point attention where it belongs. Mark what matters in seconds.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Built for AI Context',
    description: 'Paste marked-up screenshots into Claude, ChatGPT, Cursor, and other AI tools so they can understand the visual problem faster.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Useful Everywhere',
    description: 'Share clearer screenshots in Slack, Jira, GitHub, slide decks, support threads, or product reviews. Paste into the tools where work already happens.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/><path d="M12 8v4l3 3"/></svg>`,
    title: 'Lightweight by Design',
    description: 'Nudgy stays focused on capture and annotation. No bloated workflows, no feature creep. Fast, simple, stays out of the way.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Local-First',
    description: 'Your screenshots stay on your Mac. No cloud, no accounts, no uploads unless you choose otherwise. Built for sensitive work.',
  },
];
---

<section class="features" id="features-section">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Features</p>
      <h2>Everything you need to show what you mean.</h2>
      <p class="subtext">Capture, annotate, and share — without the bloat. Built for speed, clarity, and AI-ready visual context.</p>
    </div>

    <div class="grid">
      {features.map((f) => (
        <div class="card">
          <div class="icon-wrap">
            <div class="icon" set:html={f.icon} />
          </div>
          <h3>{f.title}</h3>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 5rem 1.5rem 6rem;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 940px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.12;
    margin-bottom: 0.85rem;
    color: var(--text);
  }

  .subtext {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--border);
    gap: 1px;
  }

  .card {
    background: var(--surface);
    padding: 1.75rem;
    transition: background 0.2s;
  }

  .card:hover {
    background: var(--surface-hover);
  }

  .icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(255, 107, 43, 0.07);
    border: 1px solid rgba(255, 107, 43, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .card:hover .icon-wrap {
    background: rgba(255, 107, 43, 0.12);
    border-color: rgba(255, 107, 43, 0.28);
  }

  .icon {
    color: var(--accent);
    display: flex;
    transition: filter 0.2s;
  }

  .card:hover .icon {
    filter: drop-shadow(0 0 5px rgba(255, 107, 43, 0.5));
  }

  .card h3 {
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 0.45rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .card p {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
