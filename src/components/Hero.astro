---
---

<section class="hero">

  <!-- Background glow -->
  <div class="bg-beam" aria-hidden="true"></div>

  <!-- Left: text -->
  <div class="hero-text">
    <div class="badge">
      <span class="badge-dot" aria-hidden="true"></span>
      The AI-first screenshot tool
    </div>

    <h1>
      Show the thing.<br />
      <span class="accent">Skip the essay.</span>
    </h1>

    <p class="subheadline">
      Nudgy helps vibe coders and tech teams capture screenshots, mark what matters,
      and paste visual context into Claude, ChatGPT, Cursor, Slack, Jira, or wherever work happens.
    </p>

    <p class="tagline">Less explaining. Less busywork. Faster building.</p>

    <div class="cta-group">
      <div class="cta-buttons">
        <a href="https://pub-b7c088e1d92b4658b0f591ae9c5d8b2e.r2.dev/Nudgy-0.1.0.dmg" class="btn-primary" download>
          Download for Mac · Free
        </a>
        <a href="#workflow" class="btn-secondary">
          See how it works
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </a>
      </div>
      <span class="cta-note">macOS 13.0 or later · Apple Silicon &amp; Intel</span>
      <span class="disclaimer">By downloading, you agree to our <a href="/terms">Terms of Use</a>. Provided as-is with no warranty.</span>
    </div>

    <!-- Tool logos strip -->
    <div class="tool-strip">
      <span class="tool-strip-label">Paste into</span>
      <div class="tool-chips">
        <span class="tool-chip">Claude</span>
        <span class="tool-chip">ChatGPT</span>
        <span class="tool-chip">Cursor</span>
        <span class="tool-chip">Slack</span>
        <span class="tool-chip">Linear</span>
        <span class="tool-chip">GitHub</span>
      </div>
    </div>
  </div>

  <!-- Right: mascot -->
  <div class="mascot-col">
    <img src="/assets/kiwi-mascot.png" alt="Nudgy mascot" class="mascot" />
  </div>

  <!-- Scroll cue -->
  <a href="#workflow" class="scroll-cue" aria-label="Scroll to workflow">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </a>

</section>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes pulseGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 107, 43, 0); }
    50%       { box-shadow: 0 0 28px 6px rgba(255, 107, 43, 0.22); }
  }
  @keyframes pulseDot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 107, 43, 0); }
    50%       { box-shadow: 0 0 0 4px rgba(255, 107, 43, 0.3); }
  }
  @keyframes bounceCue {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50%       { transform: translateY(5px); opacity: 0.8; }
  }

  /* ── Layout ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: auto;
    align-items: start;
    padding-top: 5vh;
    overflow: hidden;
  }

  /* ── Glow ── */
  .bg-beam {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 140vw;
    height: 120vh;
    background: radial-gradient(ellipse at top center,
      rgba(200, 75, 15, 0.55) 0%,
      rgba(180, 55, 10, 0.2) 35%,
      transparent 60%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Left column ── */
  .hero-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 14vh clamp(1.5rem, 3vw, 3rem) 3rem clamp(3rem, 7vw, 7rem);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 107, 43, 0.2);
    background: rgba(255, 107, 43, 0.05);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    margin-bottom: 1.75rem;
    width: fit-content;
    animation: fadeUp 0.7s 0.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: pulseDot 2.5s ease-in-out infinite;
  }

  h1 {
    font-size: clamp(2rem, 3.8vw, 3.8rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.7s 0.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .accent {
    background: linear-gradient(135deg, #FF6B2B 0%, #FFAA6B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subheadline {
    font-size: clamp(0.88rem, 1.3vw, 1.05rem);
    color: var(--muted);
    line-height: 1.8;
    max-width: 420px;
    margin-bottom: 1rem;
    animation: fadeUp 0.7s 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .tagline {
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.015em;
    margin-bottom: 2.5rem;
    animation: fadeUp 0.7s 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    animation: fadeUp 0.7s 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.75rem;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    animation: pulseGlow 3.5s 1.5s ease-in-out infinite;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 36px var(--accent-glow-strong);
    animation: none;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.7rem 1.25rem;
    border-radius: 10px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s, transform 0.15s;
  }

  .btn-secondary:hover {
    border-color: rgba(255, 107, 43, 0.3);
    color: var(--text);
    transform: translateY(-1px);
  }

  .btn-secondary svg {
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .btn-secondary:hover svg {
    transform: translateY(2px);
  }

  .cta-note {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }

  .disclaimer {
    color: #3a3a3a;
    font-size: 0.68rem;
    letter-spacing: 0.01em;
    line-height: 1.5;
  }

  .disclaimer a {
    color: #555;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .disclaimer a:hover {
    color: var(--muted);
  }

  /* ── Tool strip ── */
  .tool-strip {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    animation: fadeUp 0.7s 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .tool-strip-label {
    font-size: 0.68rem;
    font-weight: 500;
    color: #555;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tool-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tool-chip {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    letter-spacing: 0.01em;
    transition: border-color 0.2s, color 0.2s;
  }

  .tool-chip:hover {
    border-color: rgba(255, 107, 43, 0.2);
    color: var(--text);
  }

  /* ── Right column ── */
  .mascot-col {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: visible;
    animation: fadeIn 1s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .mascot-col::before {
    content: '';
    position: absolute;
    width: 55%;
    height: 55%;
    background: radial-gradient(circle, rgba(255, 107, 43, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    top: 42%;
    left: 38%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
  }

  .mascot {
    position: relative;
    z-index: 1;
    max-height: 105vh;
    width: auto;
    max-width: 110%;
    display: block;
    transform: translateX(-14%) translateY(5vh);
    filter: drop-shadow(0 24px 48px rgba(255, 107, 43, 0.22)) drop-shadow(0 4px 16px rgba(0,0,0,0.5));
  }

  /* ── Scroll cue ── */
  .scroll-cue {
    grid-column: 1 / -1;
    justify-self: center;
    padding: 1.5rem 0 2rem;
    z-index: 2;
    color: var(--muted);
    text-decoration: none;
    animation: bounceCue 2s ease-in-out infinite;
    transition: color 0.2s;
  }

  .scroll-cue:hover { color: var(--accent); }

  /* ── Mobile ── */
  @media (max-width: 680px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 0;
    }
    .hero-text {
      padding: 5.5rem 1.5rem 2rem;
      align-items: center;
      text-align: center;
    }
    .subheadline {
      max-width: 100%;
    }
    .badge, .subheadline, .tagline { margin-left: auto; margin-right: auto; }
    .cta-group { align-items: center; }
    .cta-buttons { flex-direction: column; width: 100%; flex-wrap: nowrap; }
    .btn-primary, .btn-secondary { width: 100%; justify-content: center; white-space: nowrap; }
    .tool-strip { align-items: center; }
    .tool-chips { justify-content: center; }
    .mascot { transform: none; width: 70%; max-height: 50vh; }
    .mascot-col { justify-content: center; min-height: auto; padding: 1rem 0 3rem; }
    .scroll-cue { display: none; }
  }
</style>
