---
const methods = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`,
    title: 'Copy to Clipboard',
    description: 'One click and the annotated image is on your clipboard. Paste into any app, any chat, any document.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
    title: 'Copy File Path',
    description: 'Get the local file path for terminal workflows. Ideal for CLI tools like Claude Code that read images from disk.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>`,
    title: 'Drag & Drop',
    description: 'Drag the thumbnail directly into Claude, ChatGPT, Slack, or any app that accepts images. Fastest path from capture to context.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
    title: 'Always Saved',
    description: 'Every capture is saved to your Downloads folder — even drag-and-drop. Unlike macOS native, nothing is ephemeral.',
  },
];
---

<section class="share-mechanics">
  <div class="container">
    <div class="section-header fade-target">
      <p class="eyebrow">How you share</p>
      <h2>Four ways out. Zero friction.</h2>
      <p class="subtext">However you work, there's a fast path from screenshot to shared context. Every capture is always saved — nothing disappears.</p>
    </div>

    <div class="methods">
      {methods.map((method, i) => (
        <div class="method fade-target" style={`--delay: ${i * 80}ms`}>
          <div class="method-icon" set:html={method.icon} />
          <div class="method-text">
            <h3>{method.title}</h3>
            <p>{method.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.style.getPropertyValue('--delay') || '0ms';
          setTimeout(() => el.classList.add('is-visible'), parseInt(delay));
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.share-mechanics .fade-target').forEach(el => observer.observe(el));
</script>

<style>
  .share-mechanics {
    padding: 5rem 1.5rem 5.5rem;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin-bottom: 0.85rem;
    color: var(--text);
  }

  .subtext {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Methods ── */
  .methods {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .method {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--surface);
    transition: background 0.25s;
  }

  .method:hover {
    background: var(--surface-hover);
  }

  .method-icon {
    color: var(--accent);
    display: flex;
    flex-shrink: 0;
    margin-top: 0.1rem;
    transition: filter 0.25s;
  }

  .method:hover .method-icon {
    filter: drop-shadow(0 0 5px rgba(255, 107, 43, 0.5));
  }

  .method-text h3 {
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--text);
    letter-spacing: -0.015em;
    margin-bottom: 0.35rem;
  }

  .method-text p {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── Scroll reveal ── */
  .fade-target {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .fade-target.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .methods {
      grid-template-columns: 1fr;
    }

    .share-mechanics {
      padding: 4rem 1.25rem;
    }
  }
</style>
